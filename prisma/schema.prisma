generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("NEON_DATABASE_URL")
  directUrl = env("NEON_DATABASE_URL_UNPOOLED")
}

model Character {
  id         String   @id @default(cuid())
  name       String
  realmSlug  String
  wowClass   String
  role       String
  blizzardId String   @unique
  addedById  String
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())
}
